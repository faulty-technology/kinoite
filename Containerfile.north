# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY build_files /
COPY cosign.pub /
# On-box runbooks, installed to /usr/share/kinoite by the profile scripts.
COPY docs /docs

# Base Image — same Fedora Kinoite (KDE) base as the laptop image
FROM quay.io/fedora/fedora-kinoite:44

### [IM]MUTABLE /opt
## Made immutable (unlinked from /var/opt) so packages like Google Chrome persist
## correctly across bootc deploys — see the base Containerfile for the rationale.
RUN rm /opt && mkdir /opt

### MODIFICATIONS
## north = gaming + local-LLM battlestation. Installs the shared baseline plus the
## north-specific profile (AMD/RDNA4 enablement, gaming core, Sunshine streaming).
## IMAGE_NAME is consumed by signing.sh so the image verifies against its own GHCR repo path.

ARG IMAGE_NAME=kinoite-north
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    IMAGE_NAME=${IMAGE_NAME} /ctx/profiles/north/build.sh

### LINTING
## Verify final image and contents are correct.
RUN bootc container lint
