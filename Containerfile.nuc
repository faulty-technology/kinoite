# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY build_files /
COPY cosign.pub /

# Base Image — headless Fedora bootc, no desktop
FROM quay.io/fedora/fedora-bootc:44

### MODIFICATIONS
## nuc = headless k3s home server (NUC12WSKi7). Apps are not baked here; Flux
## reconciles them from a separate GitOps repo. This image ships the host only.
## IMAGE_NAME is consumed by signing.sh so the image verifies against its own GHCR repo path.

ARG IMAGE_NAME=kinoite-nuc
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    IMAGE_NAME=${IMAGE_NAME} /ctx/profiles/nuc/build.sh

### LINTING
## Verify final image and contents are correct.
RUN bootc container lint
