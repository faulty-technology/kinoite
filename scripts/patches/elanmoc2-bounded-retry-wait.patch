 }
 
+static void
+elanmoc2_wait_finger (FpDevice *device, const Elanmoc2Cmd *cmd)
+{
+  /* Unbounded: fresh waits (first touch of a stage, identify/verify) must
+   * keep living while the user takes their time; abort goes through the
+   * driver cancellable. */
+  elanmoc2_wait_finger_internal (device, cmd, ELANMOC2_USB_WAIT_FINGER_TIMEOUT);
+}
+
+static void
+elanmoc2_wait_finger_retry (FpDevice *device, const Elanmoc2Cmd *cmd)
+{
+  /* Bounded: a re-armed wait after a failed stage must fail instead of
+   * parking forever if the user does not re-touch. The callback turns the
+   * timeout into fpi_ssm_mark_failed(), i.e. a clean operation failure. */
+  elanmoc2_wait_finger_internal (device, cmd, ELANMOC2_USB_WAIT_FINGER_RETRY_TIMEOUT);
+}
+
 static void
 elanmoc2_cmd_transceive_full (FpDevice          *device,
                               const Elanmoc2Cmd *cmd,
@@ -1265,8 +1290,17 @@ elanmoc2_enroll_run_state (FpiSsm *ssm, FpDevice *device)
       }
 
     case ENROLL_WAIT_FINGER: {
