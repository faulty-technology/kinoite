+                 * re-touch. A fresh message: after N identical stage
+                 * failures, repeating the first one as the terminal error
+                 * reads like a single glitch. */
+                fp_info ("Giving up on stage %d after %u failed attempts",
+                         self->enroll_stage, self->stage_retries);
+                g_clear_error (&error);
+                fpi_device_enroll_complete (device, NULL,
+                    fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                              "Enroll stage failed "
+                                              "repeatedly"));
+                fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+                return;
+              }
             if (error != NULL)
               {
                 fp_info ("Enroll stage failed: %s", error->message);
@@ -1312,6 +1367,9 @@ elanmoc2_enroll_run_state (FpiSsm *ssm, FpDevice *device)
                   {
                     fpi_device_enroll_progress (device, self->enroll_stage,
                                                 NULL, g_steal_pointer (&error));
+                    /* The re-armed wait must be bounded: if the user does
+                     * not re-touch, it has to fail, not park forever. */
+                    self->retry_wait = TRUE;
                   }
                 else
                   {
@@ -1325,6 +1383,7 @@ elanmoc2_enroll_run_state (FpiSsm *ssm, FpDevice *device)
             else
               {
                 fp_info ("Enroll stage failed for unknown reasons");
+                self->retry_wait = TRUE;
               }
           }
         fp_info ("Performing another enroll");
@@ -1431,6 +1490,8 @@ elanmoc2_enroll (FpDevice *device)
   fp_info ("[elanmoc2] New enroll operation");
 
   self->enroll_stage = 0;
+  self->stage_retries = 0;
+  self->retry_wait = FALSE;
   fpi_device_get_enroll_data (device, &self->enroll_print);
 
   self->ssm = fpi_ssm_new (device, elanmoc2_enroll_run_state,
diff --git a/libfprint/drivers/elanmoc2/elanmoc2.h b/libfprint/drivers/elanmoc2/elanmoc2.h
index 9b1b296..7975373 100644
--- a/libfprint/drivers/elanmoc2/elanmoc2.h
+++ b/libfprint/drivers/elanmoc2/elanmoc2.h
@@ -51,6 +51,17 @@
 /* Commands that block until the user touches the sensor must never time out;
  * they are aborted through the driver cancellable instead. */
 #define ELANMOC2_USB_WAIT_FINGER_TIMEOUT 0
+/* A re-armed finger wait after a FAILED enroll stage must not park the state
+ * machine forever: if the user lifts their finger after seeing "stage
+ * passed", an unbounded wait hangs fprintd-enroll indefinitely. 60s is long
+ * enough for a deliberate re-touch, short enough that a missed touch fails
+ * the operation instead of hanging. Fresh (non-retry) waits and the
+ * identify/verify waits stay unbounded so login prompts keep living while the
+ * user takes their time. */
+#define ELANMOC2_USB_WAIT_FINGER_RETRY_TIMEOUT 60000
+/* Max failed attempts per enroll stage before the operation completes with an
+ * error instead of re-arming the finger wait again. */
+#define ELANMOC2_MAX_STAGE_RETRIES 3
 /* The sensor answers commands in well under 100ms, and only answers the abort
  * command when it actually had something to abort, so draining must give up
  * quickly instead of stalling every cancel and close. */
