+            elanmoc2_wait_finger_retry (device, &cmd_enroll);
+          }
+        else
+          {
+            /* Blocks with no timeout until the user touches the sensor. */
+            elanmoc2_wait_finger (device, &cmd_enroll);
+          }
         return;
       }
 
@@ -1281,6 +1315,8 @@ elanmoc2_enroll_run_state (FpiSsm *ssm, FpDevice *device)
             /* Stage okay */
             fp_info ("Enroll stage succeeded");
             self->enroll_stage++;
+            self->stage_retries = 0;
+            self->retry_wait = FALSE;
             fpi_device_enroll_progress (device, self->enroll_stage,
                                         self->enroll_print, NULL);
             if (self->enroll_stage >= ELANMOC2_ENROLL_TIMES)
@@ -1295,6 +1331,25 @@ elanmoc2_enroll_run_state (FpiSsm *ssm, FpDevice *device)
             /* Detection error */
             gboolean can_retry = FALSE;
             error = elanmoc2_get_finger_error (buffer_in, &can_retry);
+            self->stage_retries++;
+            if (self->stage_retries > ELANMOC2_MAX_STAGE_RETRIES)
