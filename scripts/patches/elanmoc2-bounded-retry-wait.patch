 {
   FpiDeviceElanMoC2 *self = FPI_DEVICE_ELANMOC2 (device);
   FpiUsbTransfer *transfer = fpi_usb_transfer_new (device);
@@ -292,12 +299,30 @@ elanmoc2_wait_finger (FpDevice *device, const Elanmoc2Cmd *cmd)
   fpi_usb_transfer_fill_bulk (transfer, cmd->ep_in, cmd->in_len);
 
