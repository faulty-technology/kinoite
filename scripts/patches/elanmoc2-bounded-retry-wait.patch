+  unsigned int stage_retries;
+  gboolean     retry_wait;
 };
 
 G_DEFINE_TYPE (FpiDeviceElanMoC2, fpi_device_elanmoc2, FP_TYPE_DEVICE);
@@ -273,7 +278,9 @@ elanmoc2_wait_finger_callback (FpiUsbTransfer *transfer,
  * elanmoc2_resume() can re-enter it after the machine wakes up.
